# Tên ứng dụng (hiển thị trên Spring Boot banner/log)
spring.application.name=EProject

# Cấu hình JPA (Hibernate) tự động cập nhật schema DB (không dùng trong production)
spring.jpa.hibernate.ddl-auto=update

# Cấu hình kết nối CSDL (hãy điền URL, username, password thật trong bản chính)
spring.datasource.url=jdbc:mysql://localhost:3306/your_database
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password

# Hiển thị câu lệnh SQL trên console (hữu ích khi debug)
spring.jpa.show-sql=true

# Hiển thị log debug cho Spring Security
logging.level.org.springframework.security=DEBUG
